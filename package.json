{
  "name": "zenn",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "format": "prettier -w articles/**/*.md",
    "lint:text": "textlint --cache $(git diff main --name-only) -f pretty-error",
    "lint:text:fix": "textlint --cache $(git diff main --name-only) --fix",
    "lint:text:full": "textlint --cache README.md \"articles/**/*.md\" -f pretty-error",
    "lint:text:full:fix": "textlint --cache README.md \"articles/**/*.md\" --fix",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "zenn-cli": "^0.5.2"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "textlint": "^15.8.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-preset-jtf-style": "^3.0.3",
    "textlint-rule-prh": "^6.1.0"
  },
  "lint-staged": {
    "*.md": [
      "prettier -w",
      "textlint --cache --fix",
      "textlint --cache"
    ]
  }
}
